# Database: postgres (default) or mysql
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=manga
DB_USER=manga
DB_PASSWORD=replace-with-your-password

# App routing and authentication
NEXT_PUBLIC_BASE_PATH=/manga-web
AUTH_COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# Set true only when intentionally replacing the seeded admin password.
ADMIN_RESET_PASSWORD=false

# The web process forwards DB variables and these paths to the crawler.
CRAWLER_SCRIPT=/home/opc/manga-crawler/generic_manga_crawler.py
CRAWLER_PYTHON=/home/opc/manga-crawler/.venv/bin/python
CRAWLER_LOG=/home/opc/manga-crawler/crawler.log
CRAWLER_SAMPLE_CONFIG=/home/opc/manga-crawler/mangarw.config.json
MANGA_IMAGE_STORAGE=/home/opc/manga-storage

# AI translation. OpenClaw base URL must not include /v1.
AI_TRANSLATION_PROVIDER=openclaw
OPENCLAW_BASE_URL=http://openclaw:20128
OPENCLAW_API_KEY=replace-with-your-openclaw-api-key
# Backward-compatible alternative to OPENCLAW_API_KEY.
ROUTER_API_KEY=
OPENCLAW_MODEL=openclaw
# Comma-separated models shown in the UI.
OPENCLAW_MODELS=openclaw
AI_BULK_TRANSLATE_DELAY_MS=1000
AI_BULK_TRANSLATE_RETRY_COUNT=2
AI_BULK_TRANSLATE_RETRY_DELAY_MS=15000

# Export vocabulary extracted by AI to an Anki-compatible MySQL table.
ANKI_AI_DATABASE=anki
ANKI_AI_NOTES_TABLE=anki_ai_notes
ANKI_AI_NOTE_TYPE=AIWordWithImage
# Comma-separated tags. They are stored as a JSON array.
ANKI_AI_TAGS=api

# Optional Amazon Bedrock provider. Use the standard AWS credential chain.
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_REGION=ap-northeast-1
BEDROCK_DEFAULT_MODEL=
# Comma-separated model IDs shown in the UI.
BEDROCK_MODELS=

# Google Drive EPUB exports. GOOGLE_DRIVE_OAUTH accepts a JSON file path,
# inline JSON, or a refresh token accompanied by the client ID and secret.
GOOGLE_DRIVE_OAUTH=/absolute/path/to/google-drive-oauth.json
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_MAKE_PUBLIC=false

# Service-account fallback when OAuth is not configured.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
